# Server
LISTEN_ADDR=:8080
BASE_URL=http://localhost:8080

# Spam filter
#
# Submissions scoring at or above SPAM_THRESHOLD are held for review in
# /admin/quarantine rather than delivered, and are deleted after 30 days.
# Each form can override this in its own settings.
#
# The weights are absolute, so moving the threshold changes which single
# signals are enough on their own:
#   9 (lenient) — a lone link-markup hit (+6) no longer holds
#   6 (default) — one markup link holds; one keyword (+5) never does
#   4 (strict)  — a lone keyword hit now holds on its own
SPAM_THRESHOLD=6

# Daily digest of what quarantine is holding. Leave empty to disable.
# DIGEST_TO=ops@example.com

# Database (leave as default unless you have a reason to change)
DB_PATH=/data/dsforms.db

# Auth
# SECRET_KEY is used to sign flash cookies. Generate with:
#   openssl rand -base64 32
SECRET_KEY=change-me-to-a-random-32-char-string

# SMTP — sends email notifications when forms are submitted
#
# Development: Mailpit is included in docker-compose (no auth needed)
# View emails at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DSForms <noreply@example.com>
#
# Production examples (uncomment one):
#
# Gmail (use App Password: https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=DSForms <you@gmail.com>
#
# Resend (free 3k emails/month: https://resend.com)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=DSForms <noreply@yourdomain.com>
#
# Brevo (free 300/day: https://brevo.com)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-smtp-key

# Rate limiting (applied to POST /f/{formID} and POST /w/{waitlistID})
# The MCP endpoint has its own, more generous budget, so an API client polling
# for new messages cannot evict the buckets of real form submitters.
RATE_BURST=5
RATE_PER_MINUTE=6

# Backup (CLI only — optional)
# If set, "docker compose exec dsforms ./dsforms backup create" writes a
# snapshot here. Leave unset if you don't need CLI-triggered backups.
# UI export/import works regardless of this setting.
#BACKUP_LOCAL_DIR=/data/backups

# Waitlist broadcast tuning (optional)
BROADCAST_THROTTLE_MS=200      # pause in ms between individual broadcast sends
BROADCAST_MAX_ATTEMPTS=3       # delivery retries before a recipient is marked failed

# MCP endpoint (optional, off by default)
#
# Serves this instance over the Model Context Protocol at POST /mcp, so an MCP
# client can list messages, mark them read or as spam, and read statistics.
# Clients authenticate with an API token: create one at /admin/tokens, or with
#   docker compose exec dsforms ./dsforms token create <user> <name> read,write
# Tokens are scoped read / write / delete and are revocable one at a time.
#
# The route is not registered at all while this is unset — a disabled feature
# with a live endpoint is one you have to keep auditing.
#MCP_ENABLED=true

# dsforms refuses to start with MCP_ENABLED and a non-https BASE_URL, because a
# token rides an Authorization header on every request and would be readable by
# anything between the client and this server. Set this only when the instance
# is reachable over localhost or a trusted private network; it warns on every
# boot when it is set.
#MCP_ALLOW_INSECURE=true

# How long a token created at /admin/tokens lasts. 0 (the default) means it
# never expires — revoke it there instead. The CLI does not read this file, so
# it takes the days as an argument:
#   dsforms token create <user> <name> read,write 90
#MCP_TOKEN_TTL_DAYS=90

# Return submitters' IP addresses to MCP clients. Off by default: the address is
# your own data and it is what an IP block rule is written from, but the other
# end of an MCP connection is a language model with a context window and usually
# a vendor behind it. The admin UI shows IPs either way.
#MCP_INCLUDE_IPS=true
